# Generated by scripts/generate_8a_belyi_equations.py --format sage
# Ordered passport: (8,8,4,2,1)/(8,8,4,2,1)/(2^8,1^7)
# Normalize the unique 4-, 2-, and 1-fold points over 0 to 0, 1, infinity.
R = PolynomialRing(QQ, names=('alpha', 'a0', 'a1', 'b0', 'b1', 'c4', 'c2', 'c1', 'u0', 'u1', 'u2', 'u3', 'u4', 'u5', 'u6', 'u7', 'v0', 'v1', 'v2', 'v3', 'v4', 'v5', 'v6'), order="degrevlex")
(alpha, a0, a1, b0, b1, c4, c2, c1, u0, u1, u2, u3, u4, u5, u6, u7, v0, v1, v2, v3, v4, v5, v6) = R.gens()
S = PolynomialRing(R, names=("x",))
x = S.gen()
A = x**2 + a1*x + a0
B = x**2 + b1*x + b0
P = alpha*A**8*x**4*(x-1)**2
F = B**8*(x-c4)**4*(x-c2)**2*(x-c1)
U = x**8 + u7*x**7 + u6*x**6 + u5*x**5 + u4*x**4 + u3*x**3 + u2*x**2 + u1*x**1 + u0*x**0
V = x**7 + v6*x**6 + v5*x**5 + v4*x**4 + v3*x**3 + v2*x**2 + v1*x**1 + v0*x**0
Q = U**2*V
full_equations = [(P + F - Q)[i] for i in range(23)]
assert len(full_equations) == 23

# Smaller elimination presentation: U divides H and its derivative.
H = P + F
remainder_H = H % U
remainder_dH = H.derivative() % U
reduced_equations = (
    [remainder_H[i] for i in range(8)]
    + [remainder_dH[i] for i in range(8)]
)
assert len(reduced_equations) == 16

# On a solution, phi := P/H and phi-1 := -F/H.
# Saturate away collisions and require U squarefree and H/U^2 squarefree
# and coprime to U. Passport conditions alone do not certify M23 monodromy.
