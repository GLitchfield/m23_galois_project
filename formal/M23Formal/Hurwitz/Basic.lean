import Mathlib.Algebra.Group.Subgroup.Lattice
import Mathlib.Tactic.Group

/-!
# Algebraic kernel for Hurwitz moves

This file fixes the right Hurwitz convention used by the GAP implementation.
It deliberately works over an arbitrary group: none of these theorems depends
on `M23` or on finite computation.
-/

namespace M23Formal.Hurwitz

variable {G : Type*} [Group G]

/-- The adjacent pair transformation used by the project:
`(a,b) ↦ (a*b*a⁻¹,a)`. -/
def movePair (pair : G × G) : G × G :=
  (pair.1 * pair.2 * pair.1⁻¹, pair.1)

/-- The inverse adjacent Hurwitz transformation. -/
def inverseMovePair (pair : G × G) : G × G :=
  (pair.2, pair.2⁻¹ * pair.1 * pair.2)

@[simp] theorem movePair_product (pair : G × G) :
    (movePair pair).1 * (movePair pair).2 = pair.1 * pair.2 := by
  simp [movePair]

@[simp] theorem inverseMovePair_product (pair : G × G) :
    (inverseMovePair pair).1 * (inverseMovePair pair).2 = pair.1 * pair.2 := by
  simp [inverseMovePair]
  group

@[simp] theorem inverseMovePair_movePair (pair : G × G) :
    inverseMovePair (movePair pair) = pair := by
  rcases pair with ⟨a, b⟩
  simp [movePair, inverseMovePair]
  group

@[simp] theorem movePair_inverseMovePair (pair : G × G) :
    movePair (inverseMovePair pair) = pair := by
  rcases pair with ⟨a, b⟩
  simp [movePair, inverseMovePair]
  group

/-- First Hurwitz generator on a triple. -/
def move12 (tuple : G × G × G) : G × G × G :=
  (tuple.1 * tuple.2.1 * tuple.1⁻¹, tuple.1, tuple.2.2)

/-- Second Hurwitz generator on a triple. -/
def move23 (tuple : G × G × G) : G × G × G :=
  (tuple.1, tuple.2.1 * tuple.2.2 * tuple.2.1⁻¹, tuple.2.1)

/-- The two adjacent moves satisfy the Artin braid relation. -/
theorem braid_relation (tuple : G × G × G) :
    move12 (move23 (move12 tuple)) = move23 (move12 (move23 tuple)) := by
  rcases tuple with ⟨a, b, c⟩
  simp [move12, move23]
  group

/-- Simultaneous conjugation of a pair. -/
def conjugatePair (pair : G × G) (x : G) : G × G :=
  (x⁻¹ * pair.1 * x, x⁻¹ * pair.2 * x)

/-- Hurwitz moves commute with simultaneous conjugation. -/
theorem movePair_conjugatePair (pair : G × G) (x : G) :
    movePair (conjugatePair pair x) = conjugatePair (movePair pair) x := by
  rcases pair with ⟨a, b⟩
  simp [movePair, conjugatePair]
  group

/-- The subgroup generated by the entries of a pair. -/
def pairSubgroup (pair : G × G) : Subgroup G :=
  Subgroup.closure {pair.1, pair.2}

/-- An adjacent Hurwitz move preserves the generated subgroup. -/
theorem movePair_pairSubgroup (pair : G × G) :
    pairSubgroup (movePair pair) = pairSubgroup pair := by
  rcases pair with ⟨a, b⟩
  apply le_antisymm
  · apply (Subgroup.closure_le _).2
    intro x hx
    simp only [movePair, pairSubgroup, Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with hx | hx
    · subst x
      exact (Subgroup.closure {a, b}).mul_mem
        ((Subgroup.closure {a, b}).mul_mem
          (Subgroup.subset_closure (by simp))
          (Subgroup.subset_closure (by simp)))
        ((Subgroup.closure {a, b}).inv_mem (Subgroup.subset_closure (by simp)))
    · subst x
      exact Subgroup.subset_closure (by simp)
  · apply (Subgroup.closure_le _).2
    intro x hx
    simp only [movePair, pairSubgroup, Set.mem_insert_iff, Set.mem_singleton_iff] at hx ⊢
    rcases hx with hx | hx
    · subst x
      exact Subgroup.subset_closure (by simp)
    · subst x
      have ha : a ∈ Subgroup.closure {a * b * a⁻¹, a} :=
        Subgroup.subset_closure (by simp)
      have haba : a * b * a⁻¹ ∈ Subgroup.closure {a * b * a⁻¹, a} :=
        Subgroup.subset_closure (by simp)
      have reconstructed : a⁻¹ * (a * b * a⁻¹) * a = b := by group
      have hmem := (Subgroup.closure {a * b * a⁻¹, a}).mul_mem
        ((Subgroup.closure {a * b * a⁻¹, a}).mul_mem
          ((Subgroup.closure {a * b * a⁻¹, a}).inv_mem ha) haba) ha
      simpa only [reconstructed] using hmem

end M23Formal.Hurwitz
